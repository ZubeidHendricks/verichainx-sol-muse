# Cluster: devnet (v1) or mainnet
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Service keys: base58 64-byte secret keys or solana-keygen JSON arrays (§7.5). Never commit real ones.
FEE_PAYER_SECRET=
SETTLEMENT_SECRET=
ANCHOR_SECRET=
VAULT_SECRET=
TREASURY_ADDRESS=

# Devnet test USDC mint created by `npm run devnet:setup`
USDC_MINT=
PROTOCOL_FEE_BPS=100

# Public URL used in Solana Pay links, Blinks and Shopify callbacks
APP_URL=http://localhost:3000

# Meta Model API key for Muse Spark, the buyer agent's first choice (same key as GlobalChain Muse)
MODEL_API_KEY=
MUSE_MODEL=muse-spark-1.3
REASONING_EFFORT=medium
# muse, groq or scripted; empty tries Muse, then Groq, then the scripted engine
AGENT_PROVIDER=

# Groq API key for the buyer agent when Muse is unavailable (keep it in .env.local only)
GROQ_API_KEY=

# Photo comparison by a vision model when a listing photo isn't one of the registered ones: muse, groq or off
# (default off: each comparison sends images). GROQ_VISION_MODEL defaults to qwen/qwen3.8-27b.
PHOTO_MODEL=

# Devnet demo: shops may let the service hold their wallet, and the seeded demo shops are manageable by anyone
# signed in. Shops always sign in with their wallet (Sign In With Solana).
MERCHANT_DEMO=

# Other apps whose agents the shopping agent asks, comma-separated base URLs (they publish /.well-known/vcx-agent.json)
AGENT_PEERS=
# Demo: an outlet agent that copies real offers (same NFT, half price) so the copy check shows up live
DEMO_COPIER=

# Shopify app (Partner Dashboard): API key and secret, keep the secret in .env.local only
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-10
